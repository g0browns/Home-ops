# =============================================================================
# Home Ops — configuration
#
#   cp .env.example .env                    # macOS / Linux
#   Copy-Item .env.example .env             # Windows PowerShell
#
# `.env` is git-ignored and must never be committed (SPEC §2.2). Every variable
# the application reads is listed here, and a test fails if this file and
# `config.py` ever drift (SPEC §8.4).
#
# The password is written once and the port is written once; `config.py`
# assembles the connection URL and the origin list from them. Two copies of one
# value is a place for them to disagree, and the disagreement is always quiet.
#
# The one deliberate exception is TRUSTED_PROXY_IPS, which usually equals
# COMPOSE_NETWORK_SUBNET and is still stated separately. Deriving a connection
# string is a convenience; deriving who is allowed to tell us a client's IP
# address is a security decision, and it stays something you type on purpose.
# =============================================================================


# -----------------------------------------------------------------------------
# START HERE — the only lines most people need to change
# -----------------------------------------------------------------------------

# 1. The database password. Set it BEFORE the first `docker compose up`:
#    Postgres bakes it into its data directory on first boot and changing it
#    later does not re-create the user. Any characters are fine — it is escaped
#    wherever it is used.
#
#      openssl rand -hex 24
#
POSTGRES_PASSWORD=change_me_before_first_boot

# 2. The port the app is served on. This is the only place it is written.
WEB_PORT=8080

# 3. Every hostname and IP you will reach the app on over plain HTTP — the
#    tailnet name and the LAN address. NAMES ONLY: no scheme, no port, comma
#    separated. Each becomes an allowed origin on WEB_PORT above, which is what
#    lets a browser on that address log in (SPEC §2.1).
#
#    Leave the Cloudflare hostname out of this: it arrives on 443, not on
#    WEB_PORT, so it belongs in PUBLIC_BASE_URL below.
#
APP_HOSTS=localhost,192.168.1.10,home-server.tailnet-name.ts.net

# 4. The HTTPS address, if you have a Cloudflare Tunnel. It is also used for
#    links that leave the app, because it is the only path reachable from
#    outside the house. Leave blank if you have no tunnel — the first entry in
#    APP_HOSTS is used instead.
PUBLIC_BASE_URL=https://home.example.com


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

# `development` enables /api/docs and verbose errors. `production` disables both.
# docker-compose.yml sets this to production on its own; the dev override sets
# it to development. You rarely need to touch it here.
APP_ENV=development

# Reported by the readiness probe so you can tell which build is running.
APP_VERSION=0.1.0-dev

# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO

# IANA timezone name. Used for log timestamps and for scheduling.
# Never an offset like "+01:00" — offsets cannot survive daylight saving.
TZ=Europe/London


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

POSTGRES_USER=home_ops
POSTGRES_DB=home_ops

# Where the database is. Inside Docker this is the `db` service and compose
# sets it for you. Change it only to point at a Postgres you run elsewhere.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Host port the database is published on for host-native tooling (psql, an IDE,
# running pytest outside Docker). Development only. 5433 rather than 5432 to
# avoid colliding with a Postgres you may already run locally.
DB_PORT=5433

# Leave blank. The connection URL is assembled from the POSTGRES_* values above
# with each part properly escaped. Set it only to reach a database those fields
# cannot describe — a managed instance, or one needing query parameters.
# For host-native runs, prefer POSTGRES_HOST=localhost and POSTGRES_PORT=5433.
DATABASE_URL=


# -----------------------------------------------------------------------------
# The three access paths (SPEC §2.1)
#
# The app answers over HTTPS via Cloudflare Tunnel and over plain HTTP on both
# the tailnet and the LAN. None of this may be derived from the `Host` header,
# so it is all explicit configuration.
# -----------------------------------------------------------------------------

# Leave blank. Built from APP_HOSTS, WEB_PORT and PUBLIC_BASE_URL. Set it only
# for an origin those cannot express, and then list every origin — an explicit
# value replaces the built one rather than adding to it.
TRUSTED_ORIGINS=

# Session cookies MUST NOT be hardcoded Secure: a Secure cookie is silently
# dropped over HTTP, which would lock out the tailnet and LAN paths entirely.
# Keep this false unless *every* access path is HTTPS.
SESSION_COOKIE_SECURE=false

# Internal subnet for the compose network. Change it only if 172.28.0.0/16
# collides with an existing Docker network or a route on your LAN.
COMPOSE_NETWORK_SUBNET=172.28.0.0/16

# Peers whose forwarding headers we honour: the `web` container, not clients.
# Requests from any other peer have their X-Real-IP / X-Forwarded-For /
# CF-Connecting-IP ignored, so a LAN client cannot spoof its own address.
#
# This one is NOT derived from COMPOSE_NETWORK_SUBNET even though it matches it.
# Empty means "trust nobody"; defaulting it to a subnet would quietly turn that
# into "trust every container on the network". Change it with the subnet above.
TRUSTED_PROXY_IPS=172.28.0.0/16

# The cloudflared connector's address(es). CF-Connecting-IP is honoured *only*
# when the hop into the reverse proxy came from here — i.e. only on the tunnel
# path. Empty means never trusted, which is the safe default until the tunnel
# container is on the network.
TUNNEL_PROXY_IPS=


# -----------------------------------------------------------------------------
# Sessions and authentication
# -----------------------------------------------------------------------------

# The session cookie is httpOnly; the CSRF cookie is deliberately readable by
# JavaScript, because the frontend has to echo it back in a header. Neither sets
# a Domain attribute, so cookies stay host-scoped and the three access paths get
# three independent sessions that cannot collide.
SESSION_COOKIE_NAME=home_ops_session
CSRF_COOKIE_NAME=home_ops_csrf

# Session lifetime, rolling: activity pushes the expiry out. 336h = 14 days.
SESSION_TTL_HOURS=336

# Login rate limiting and lockout. Failures are counted against the username
# that was *attempted*, whether or not it exists, so this cannot be used to work
# out which accounts are real.
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_MAX_FAILURES_PER_USERNAME=5
LOGIN_MAX_FAILURES_PER_IP=20


# -----------------------------------------------------------------------------
# First-run setup
# -----------------------------------------------------------------------------

# While the household has no users, the app serves an unauthenticated setup page
# and whoever completes it becomes the admin. The Cloudflare tunnel is the one
# path a stranger could reach, so by default setup is refused there and allowed
# only over the tailnet and LAN. It has no effect once any user exists — the
# endpoint stops existing.
SETUP_ALLOW_TUNNEL_PATH=false


# -----------------------------------------------------------------------------
# Health checks
# -----------------------------------------------------------------------------

# GET /api/health is public and returns only {"status":"ok"} — it is reachable
# on the public Cloudflare hostname, so it discloses nothing.
#
# GET /api/health/ready returns database and migration detail. If this token is
# set, that endpoint requires a matching `X-Healthcheck-Token` header. Leave
# empty to expose readiness detail unauthenticated (fine on a private network,
# not on the public hostname). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
HEALTHCHECK_TOKEN=


# -----------------------------------------------------------------------------
# Uploads (SPEC §4.6)
# -----------------------------------------------------------------------------

# Where uploaded recipe images live. A Docker volume, not a bind mount, so it
# survives `docker compose down` and is not inside the repository.
#
# IMPORTANT: a database dump alone is not a complete backup. scripts/backup.*
# produce one archive containing both this directory and the pg_dump, and
# scripts/restore.* put both back. Changing this path means changing those.
UPLOAD_ROOT=/data/uploads

# Largest single upload accepted, in bytes, before decoding. The pixel-count cap
# in the image pipeline is the one that stops a decompression bomb; this only
# stops the obvious case.
UPLOAD_MAX_BYTES=10485760


# -----------------------------------------------------------------------------
# Development only
# -----------------------------------------------------------------------------

# The API published directly on the host, for curl and /api/docs. Production
# does not expose it at all: the `web` container proxies /api on WEB_PORT, so
# there is exactly one origin to secure.
API_PORT=8000

# Hostnames the Vite dev server will answer to, beyond localhost and bare IPs.
# Only needed if you reach the *development* stack through a tunnel or a proxy:
# Vite rejects an unrecognised Host as DNS-rebinding protection, and the symptom
# is "Blocked request. This host is not allowed." rather than the app.
#
# Development only -- production is nginx, which does not consult this. Add the
# same hostname to APP_HOSTS too, or the API will refuse the origin.
DEV_ALLOWED_HOSTS=


# -----------------------------------------------------------------------------
# The single-container deployment (docker-compose.single.yml)
#
# Everything above applies there too, with two differences compose sets for you:
# POSTGRES_HOST is 127.0.0.1 (the database is in the container) and
# TRUSTED_PROXY_IPS is 127.0.0.1/32 (so is the reverse proxy).
# -----------------------------------------------------------------------------

# Have the container apply migrations on start.
#
# Read by the container's init, not by the application, so it does nothing at all
# in the three-container stack -- there you apply migrations yourself.
#
# SPEC §0 says production never auto-migrates, and that stays the default. The
# rule assumed you were already at a terminal running compose; in an appliance
# deployment, "run one more command inside the container before it works" is the
# friction that shape exists to remove. Setting this is a deliberate act, which
# is what the rule was protecting.
RUN_MIGRATIONS=false
