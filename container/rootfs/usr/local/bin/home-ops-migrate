#!/bin/bash
# Apply migrations by hand, from outside the container:
#
#   docker exec <container> home-ops-migrate
#   docker exec <container> home-ops-migrate downgrade -1
#   docker exec <container> home-ops-migrate current
#
# This exists because the obvious command does not work. `docker exec ... alembic
# upgrade head` reads the container's environment, and if the .env that started
# the container came from the multi-container stack it says POSTGRES_HOST=db --
# a name that resolves to nothing in here. The failure is a wall of SQLAlchemy
# traceback ending in "failed to resolve host 'db'", which reads as a broken
# image rather than a stale variable.
#
# It was found by following this project's own documented instruction and
# watching it fail, which is the argument for the instruction being a script.
set -euo pipefail

# The same override the api and migrate services use. One copy, three callers.
. /etc/s6-overlay/scripts/app-env

cd /app

# Default to the thing people want; anything else passes straight through.
# `set --` rather than "${@:-upgrade head}", which expands to ONE argument
# containing a space and has alembic complain about an unknown command.
if [ "$#" -eq 0 ]; then
    set -- upgrade head
fi

# Absolute path: s6 puts its tools in /command and adds that to PATH from its own
# init, not from the image's ENV — so a `docker exec` shell does not have it, and
# the first version of this script died with "s6-setuidgid: not found".
exec /command/s6-setuidgid appuser alembic -c /app/alembic.ini "$@"
